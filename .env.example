# TraceOps Local Environment Configuration Example
# Copy this file to .env for local development

# Application Settings
APP_NAME="TraceOps API"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Binding (8000 or 8001 if 8000 is occupied)
HOST=0.0.0.0
PORT=8001

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=traceops
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/traceops
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30.0

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000"]
